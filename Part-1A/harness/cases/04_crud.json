{
 "suite": "crud",
 "description": "Create, list order, update, delete, 404, and updates across two months",
 "cases": [
  {
   "id": "CRUD-001-E1",
   "spec_ref": "FR-001",
   "phase": "write",
   "kind": "required",
   "request": {
    "method": "POST",
    "path": "/api/expenses",
    "body": {
     "amount": "100.00",
     "description": "E1 original",
     "category": "Food",
     "payment_method": "Cash",
     "expense_date": "2026-03-05"
    }
   },
   "expected_status": 201,
   "expected_body_or_fields": {
    "id": "$int",
    "amount": "100.00",
    "description": "E1 original",
    "category": "Food",
    "payment_method": "Cash",
    "expense_date": "2026-03-05",
    "created_at": "$utc",
    "updated_at": "$utc"
   },
   "save": {
    "e1": "id",
    "e1_created": "created_at"
   }
  },
  {
   "id": "CRUD-002-E2",
   "spec_ref": "FR-001",
   "phase": "write",
   "kind": "required",
   "request": {
    "method": "POST",
    "path": "/api/expenses",
    "body": {
     "amount": "50.00",
     "description": "E2 original",
     "category": "Transport",
     "payment_method": "UPI",
     "expense_date": "2026-03-06"
    }
   },
   "expected_status": 201,
   "expected_body_or_fields": {
    "id": "$int",
    "amount": "50.00",
    "description": "E2 original",
    "category": "Transport",
    "payment_method": "UPI",
    "expense_date": "2026-03-06",
    "created_at": "$utc",
    "updated_at": "$utc"
   },
   "save": {
    "e2": "id"
   }
  },
  {
   "id": "CRUD-003-LIST-MARCH",
   "spec_ref": "FR-002",
   "phase": "write",
   "kind": "required",
   "request": {
    "method": "GET",
    "path": "/api/expenses?month=2026-03"
   },
   "expected_status": 200,
   "expected_body_or_fields": [
    {
     "id": "$var:e2",
     "amount": "50.00",
     "description": "E2 original",
     "category": "Transport",
     "payment_method": "UPI",
     "expense_date": "2026-03-06",
     "created_at": "$utc",
     "updated_at": "$utc"
    },
    {
     "id": "$var:e1",
     "amount": "100.00",
     "description": "E1 original",
     "category": "Food",
     "payment_method": "Cash",
     "expense_date": "2026-03-05",
     "created_at": "$utc",
     "updated_at": "$utc"
    }
   ],
   "note": "Newest date first."
  },
  {
   "id": "CRUD-004-SUM-MARCH",
   "spec_ref": "FR-025, FR-029, FR-034",
   "phase": "write",
   "kind": "required",
   "request": {
    "method": "GET",
    "path": "/api/summary?month=2026-03"
   },
   "expected_status": 200,
   "expected_body_or_fields": {
    "month": "2026-03",
    "total_spent": "150.00",
    "expense_count": 2,
    "total_recorded_count": 79,
    "by_category": [
     {
      "category": "Food",
      "total": "100.00",
      "count": 1
     },
     {
      "category": "Transport",
      "total": "50.00",
      "count": 1
     }
    ],
    "budget": null,
    "remaining": null,
    "over_budget": false,
    "over_budget_by": null
   },
   "derivation": "E1 100.00 (Food) + E2 50.00 (Transport) = 150.00, count 2; Food 100.00 then Transport 50.00."
  },
  {
   "id": "CRUD-005-PUT-INVALID",
   "spec_ref": "FR-003, FR-014, contracts/api.md PUT",
   "phase": "write",
   "kind": "required",
   "request": {
    "method": "PUT",
    "path": "/api/expenses/{{e1}}",
    "body": {
     "amount": "0",
     "description": "E1 original",
     "category": "Food",
     "payment_method": "Cash",
     "expense_date": "2026-03-05"
    }
   },
   "expected_status": 422,
   "expected_body_or_fields": {
    "code": "validation_error",
    "message": "$str",
    "errors": [
     {
      "field": "amount",
      "message": "Amount must be greater than zero"
     }
    ]
   },
   "note": "A rejected update leaves the stored expense unchanged."
  },
