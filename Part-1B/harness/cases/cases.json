{
  "dataset_version": "1.0",
  "description": "Evaluation cases for the Natural-Language Reminder Agent. Written from specs/001-nl-reminder-agent/spec.md before any model run. Expected values come from the spec and the fixed 'now', never from model output, and must not be edited to match a run.",
  "authored_on": "2026-11-23",
  "fixed_now": "2026-11-23T10:00:00+05:30",
  "fixed_now_note": "Monday 2026-11-23 10:00 at UTC+05:30. 'Friday' therefore means 2026-11-27 and 'next Monday' means 2026-11-30.",
  "layers": {
    "structural": "Raw model reply parses as JSON and validates against the strict AgentResult schema (judged before the past-time guard).",
    "property": "Deterministic checks on the final result that need no expected answer: the per-intent field rules, ISO 8601 with offset, scheduled_at not before now, plus the case-specific 'properties' listed below.",
    "semantic": "Final result matches 'expected': intent equal; for CREATE and RESCHEDULE every keyword present (case-insensitive) and scheduled_at within tolerance_minutes of the expected instant; for CLARIFY the question contains at least one of clarification_keywords_any. 'rubric' states the intent of the check where exact wording is unsuitable."
  },
  "property_vocabulary": {
    "scheduled_at_null": "result.scheduled_at is null",
    "title_null": "result.title is null",
    "clarification_null": "result.clarification is null",
    "reference_null": "result.reminder_reference is null",
    "clarification_present": "result.clarification is a non-empty string",
    "scheduled_at_not_before_now": "result.scheduled_at is null or not earlier than now",
    "title_excludes_forbidden_terms": "result.title contains none of the case's forbidden_terms (case-insensitive)"
  },
  "cases": [
    {
      "id": "TC-01-create-explicit-iso",
      "group": "normal_create",
      "category": "create_explicit_datetime",
      "tags": [],
      "requirements": ["FR-001", "FR-002", "FR-003"],
      "spec_ref": "User Story 1, scenario 1",
      "text": "Remind me to submit the report on 2026-12-01 at 09:00",
      "now": "2026-11-23T10:00:00+05:30",
      "expected": {
        "intent": "CREATE",
        "title_keywords": ["report"],
        "scheduled_at": "2026-12-01T09:00:00+05:30",
        "tolerance_minutes": 0
      },
      "properties": ["reference_null", "scheduled_at_not_before_now"],
      "rubric": "A complete request with an explicit date and time must produce CREATE with the stated instant; nothing extra is invented."
    },
    {
